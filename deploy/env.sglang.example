# Community SGLang auto-deploy (HF apps, or --engine sglang)
# HF apps: INFERENCE_ENGINE=sglang  or  HF_BACKEND=sglang
AUTO_DEPLOY_MODEL=true
AUTO_DEPLOY_TEARDOWN_ON_EXIT=true
AUTO_DEPLOY_WAIT_SECONDS=300

INFERENCE_ENGINE=sglang
HF_BACKEND=sglang
MODEL_DEPLOY_MODE=replica
SGLANG_REPLICA_COUNT=1
TENSOR_PARALLEL_SIZE=1
GPU_DEVICES=0
SGLANG_PORT=8000
# Official runtime image; container listens on 30000, host port is SGLANG_PORT
SGLANG_IMAGE=lmsysorg/sglang:latest-runtime
SGLANG_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct
SGLANG_CONTEXT_LENGTH=8192
# Optional parsers for IDE tool loops / reasoning models
# SGLANG_TOOL_CALL_PARSER=qwen25
# SGLANG_REASONING_PARSER=qwen3
# TRUST_REMOTE_CODE=false

HUGGING_FACE_HUB_TOKEN=
# SGLANG_API_URL=http://127.0.0.1:8000/v1/chat/completions
