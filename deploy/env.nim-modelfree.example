# Model-free NIM: one generic image serves weights NVIDIA does not host.
# Images (NGC, 2026):
#   nvcr.io/nim/nvidia/sglang-model-free-nim:latest   (tag 2.1.2)
#   nvcr.io/nim/nvidia/vllm-model-free-nim:latest     (tag 2.1.1)
# NIM apps stay engine=nim. NIM_BACKEND picks the model-free image when
# NIM_IMAGE is unset. Catalog images (nvcr.io/nim/<org>/<model>) ignore
# NIM_MODEL_PATH and keep baked weights.

AUTO_DEPLOY_MODEL=true
AUTO_DEPLOY_TEARDOWN_ON_EXIT=true
NGC_API_KEY=
HUGGING_FACE_HUB_TOKEN=

NIM_BACKEND=sglang
NIM_IMAGE=nvcr.io/nim/nvidia/sglang-model-free-nim:latest
# hf:// s3:// ngc:// or an absolute path mounted into the container
NIM_MODEL_PATH=hf://Qwen/Qwen2.5-Coder-32B-Instruct
NIM_SERVED_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct
NIM_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct
# Optional explicit profile from `list-model-profiles` (sglang-tp1-pp1-...)
# NIM_MODEL_PROFILE=
NIM_TENSOR_PARALLEL_SIZE=1
TENSOR_PARALLEL_SIZE=1
GPU_DEVICES=0
NIM_PORT=8000
NIM_CACHE=~/.cache/nim
