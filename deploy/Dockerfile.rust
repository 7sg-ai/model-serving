FROM rust:1.83-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY . /app
RUN cargo build --release --workspace

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/hf-ide-assistant /usr/local/bin/
COPY --from=builder /app/target/release/nim-ide-assistant /usr/local/bin/
COPY --from=builder /app/target/release/hf-streamlit-chat /usr/local/bin/
COPY --from=builder /app/target/release/nim-streamlit-chat /usr/local/bin/
COPY --from=builder /app/target/release/hf-webrtc-voice /usr/local/bin/
COPY --from=builder /app/target/release/nim-webrtc-voice /usr/local/bin/
COPY --from=builder /app/target/release/deploy /usr/local/bin/
COPY --from=builder /app/target/release/generate-vllm-compose /usr/local/bin/
COPY --from=builder /app/target/release/generate-profile-data /usr/local/bin/
COPY . /app

ENV HOST=0.0.0.0
