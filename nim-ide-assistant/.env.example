# NIM API Configuration
NIM_API_URL=http://localhost:8000/v1/chat/completions
# Default: tool-capable (function calling) coding model
NIM_MODEL_NAME=qwen/qwen2.5-coder-32b-instruct

# API Key for IDE access
API_KEY=nim-coding-assistant-key

# Model Parameters (complicated coding defaults)
# MAX_TOKENS: Maximum tokens in each response (per-request limit)
#   32768 supports long multi-file code generation / refactors
MAX_TOKENS=32768
# TEMPERATURE: Response randomness (0.0 = deterministic, 1.0 = creative)
#   Lower values are better for precise coding
TEMPERATURE=0.3
# CONTEXT_WINDOW: Total conversation history the model can see (must be > MAX_TOKENS)
#   1048576 = 1M tokens for large codebases / multi-file context
CONTEXT_WINDOW=1048576

# Caching & Memory (speeds up repeated / follow-up requests)
# CACHE_ENABLED: Cache identical completion requests in memory
CACHE_ENABLED=true
# CACHE_MAX_SIZE: Max number of cached responses (LRU eviction)
CACHE_MAX_SIZE=256
# CACHE_TTL_SECONDS: How long cached responses remain valid
CACHE_TTL_SECONDS=3600
# MEMORY_MAX_CONVERSATIONS: Rolling in-memory conversation sessions
MEMORY_MAX_CONVERSATIONS=128
# REQUEST_TIMEOUT: Seconds to wait for upstream NIM responses (long gens need more)
REQUEST_TIMEOUT=300


# --- Multi-node (optional) ---
# MULTI_NODE=true
# CLUSTER_NAME=model-serving
# NODE_ID=nim-ide-1
# HOST=0.0.0.0
# PORT=8080
# PUBLIC_URL=https://models.example.com
# SHARED_DATA_DIR=/data/model-serving
# REDIS_URL=redis://redis:6379/0
# USE_REDIS=true
# SECRET_KEY=replace-with-long-random-string
# BACKEND_URLS=http://nim-a:8000/v1/chat/completions,http://nim-b:8000/v1/chat/completions
# BACKEND_STRATEGY=round_robin
# STICKY_SESSIONS=true
# WORKERS=2
# THREADS=8

# --- NeMo Switchyard (multi-model + escalation router) ---
# See shared/switchyard/README.md and switchyard-models.example.json
# SWITCHYARD_ENABLED=true
# SWITCHYARD_STRATEGY=escalation
# SWITCHYARD_ROUTE_ID=switchyard/agent
# SWITCHYARD_CONFIG=./switchyard-models.example.json
# Or convenience env (independent deploy params per tier):
# SWITCHYARD_WEAK_MODEL=qwen/qwen2.5-coder-32b-instruct
# SWITCHYARD_WEAK_URL=http://localhost:8000/v1/chat/completions
# SWITCHYARD_WEAK_CUDA_VISIBLE_DEVICES=0
# SWITCHYARD_WEAK_MAX_TOKENS=8192
# SWITCHYARD_STRONG_MODEL=qwen/qwen3-235b-a22b
# SWITCHYARD_STRONG_URL=http://localhost:8001/v1/chat/completions
# SWITCHYARD_STRONG_CUDA_VISIBLE_DEVICES=1,2,3,4
# SWITCHYARD_STRONG_TENSOR_PARALLEL_SIZE=4
# SWITCHYARD_STRONG_MAX_TOKENS=32768
# SWITCHYARD_JUDGE_MODEL=qwen/qwen2.5-coder-32b-instruct
# SWITCHYARD_JUDGE_URL=http://localhost:8000/v1/chat/completions
# SWITCHYARD_ESCALATION_CONFIRMATIONS=2
# SWITCHYARD_ROUTES_TOML=./routes.toml
# SWITCHYARD_SERVER_URL=http://127.0.0.1:4000

# --- IDE tool passthrough (Cline/Cursor tools forwarded to upstream) ---
# IDE_TOOL_NUDGE=true
