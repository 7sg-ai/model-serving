# HuggingFace Model Configuration

# Default: Moonshot Kimi-K3 (1M context, strong coding / agentic workloads)
HF_MODEL_NAME=moonshotai/Kimi-K3
# Required for Kimi-K3 custom modeling code
HF_TRUST_REMOTE_CODE=true
# Weight dtype: bfloat16 | float16 | float32 | auto
HF_TORCH_DTYPE=bfloat16
# Accelerate device map (auto recommended for multi-GPU / large MoE)
HF_DEVICE_MAP=auto

# API Key for IDE access
API_KEY=hf-coding-assistant-key


# Model Parameters (complicated coding defaults)
# MAX_TOKENS: Maximum tokens in each response (per-request limit)
#   32768 supports long multi-file code generation / refactors
#   Note: actual generation is capped by the model's native context
MAX_TOKENS=32768
# TEMPERATURE: Response randomness (0.0 = deterministic, 1.0 = creative)
#   Lower values are better for precise coding
TEMPERATURE=0.3
# CONTEXT_WINDOW: Total conversation history budget (must be > MAX_TOKENS)
#   1048576 = 1M tokens for large codebases / multi-file context
#   Server trims to the model's effective context automatically
CONTEXT_WINDOW=1048576

# Caching & Memory (speeds up repeated / follow-up requests)
# CACHE_ENABLED: Cache identical completion requests
CACHE_ENABLED=true
# CACHE_MAX_SIZE: Max number of L1 cached responses (LRU eviction)
CACHE_MAX_SIZE=256
# CACHE_TTL_SECONDS: How long cached responses remain valid
CACHE_TTL_SECONDS=3600
# MEMORY_MAX_CONVERSATIONS: Rolling in-memory conversation sessions
MEMORY_MAX_CONVERSATIONS=128

# Mooncake (auto-enabled for Moonshot / Kimi models such as moonshotai/Kimi-K3)
# Install: pip install mooncake-transfer-engine
# Start master before the server (see Mooncake docs), then:
# MOONCAKE_CACHE: auto | true | false  (auto = on for Moonshot models)
MOONCAKE_CACHE=auto
MOONCAKE_MASTER=127.0.0.1:50051
MOONCAKE_LOCAL_HOSTNAME=localhost
MOONCAKE_METADATA_SERVER=P2PHANDSHAKE
MOONCAKE_PROTOCOL=tcp
# MOONCAKE_RDMA_DEVICES=
# MOONCAKE_GLOBAL_SEGMENT_SIZE=536870912
# MOONCAKE_LOCAL_BUFFER_SIZE=134217728
# MOONCAKE_KEY_PREFIX=hf-ide:moonshotai/Kimi-K3


# --- Multi-node (optional) ---
# MULTI_NODE=true
# CLUSTER_NAME=model-serving
# NODE_ID=hf-ide-1
# HOST=0.0.0.0
# PORT=8081
# PUBLIC_URL=https://models.example.com
# SHARED_DATA_DIR=/data/model-serving
# REDIS_URL=redis://redis:6379/0
# USE_REDIS=true
# SECRET_KEY=replace-with-long-random-string
# BACKEND_URLS=http://nim-a:8000/v1/chat/completions,http://nim-b:8000/v1/chat/completions
# BACKEND_STRATEGY=round_robin
# STICKY_SESSIONS=true
# WORKERS=2
# THREADS=8

# --- NeMo Switchyard (multi-model + escalation router) ---
# See shared/switchyard/README.md and switchyard-models.example.json
# SWITCHYARD_ENABLED=true
# SWITCHYARD_STRATEGY=escalation
# SWITCHYARD_ROUTE_ID=switchyard/agent
# SWITCHYARD_CONFIG=./switchyard-models.example.json
# Per-model local deploy (independent GPUs / dtype / TP):
# SWITCHYARD_WEAK_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# SWITCHYARD_WEAK_LOCAL=true
# SWITCHYARD_WEAK_CUDA_VISIBLE_DEVICES=0
# SWITCHYARD_STRONG_MODEL=moonshotai/Kimi-K3
# SWITCHYARD_STRONG_LOCAL=true
# SWITCHYARD_STRONG_CUDA_VISIBLE_DEVICES=1,2,3,4,5,6,7
# SWITCHYARD_STRONG_TENSOR_PARALLEL_SIZE=8
# SWITCHYARD_STRONG_DEVICE_MAP=auto
# SWITCHYARD_STRONG_TORCH_DTYPE=bfloat16
# SWITCHYARD_JUDGE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# SWITCHYARD_JUDGE_LOCAL=true
# SWITCHYARD_ESCALATION_CONFIRMATIONS=2
# SWITCHYARD_ROUTES_TOML=./routes.toml

# --- IDE tool passthrough (Cline/Cursor tools forwarded to upstream) ---
# IDE_TOOL_NUDGE=true
